# ══════════════════════════════════════════════
# FN Mercadinho — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o arquivo .env
# ══════════════════════════════════════════════

# Banco de dados
DATABASE_URL=postgresql+asyncpg://fn_user:changeme@localhost:5432/fn_mercadinho
DB_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-TODO

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evo_key_change_me
WHATSAPP_INSTANCE=fn-mercadinho

# JWT
JWT_SECRET=troque_por_string_aleatoria_de_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Admin inicial (será alterado no primeiro login)
ADMIN_EMAIL=TODO@email.com
ADMIN_PASSWORD=TroqueEstaSenh@123

# Ambiente
ENV=development
LOG_LEVEL=INFO

# CORS (produção: colocar domínio real)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Caminho do config do negócio
BUSINESS_CONFIG_PATH=../config/business.yaml
